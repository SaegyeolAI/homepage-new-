SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contact@saegyeol.ai.kr
SMTP_PASS=
CONTACT_RECIPIENT=contact@saegyeol.ai.kr

PORT=3000

# 문의·채용 API가 받아줄 Origin 목록(쉼표 구분).
# 운영(VERCEL_ENV=production)에서 이 값이 비어 있으면 폼이 503으로 막힌다.
#
# 로컬에서 브라우저로 폼을 시험할 거라면 로컬 주소도 넣어야 한다.
# 안 넣으면 같은 출처 POST에도 Origin 헤더가 붙어 403이 난다.
# (아예 비워두면 로컬에서는 검사를 건너뛴다.)
ALLOWED_ORIGIN=https://saegyeol.ai.kr,https://www.saegyeol.ai.kr,http://localhost:3000

# rate limit(10분 5회) 저장소.
# 운영에서 비어 있으면 폼이 503으로 막힌다. 프리뷰·로컬은 인메모리로 동작한다.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
